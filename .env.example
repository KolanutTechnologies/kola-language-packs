# Template for API keys used by scripts/test-translation-apis.mjs and try-mansa-once.mjs
# Real values live in Windows Credential Manager, never in a file:
#   cmdkey /generic:kola:<name> /user:api /pass:<VALUE>
# Scripts resolve secrets via scripts/lib/secrets.mjs (env -> Credential Manager -> .env)

## Mansa translation API - https://all-lab-portal.com
ALL_LAB_PORTAL_API_KEY=

## Khaya / Ghana NLP translation API - https://translation.ghananlp.org/
TRANSLATION_API_PRIMARY_KEY=
TRANSLATION_API_SECONDARY_KEY=
